// 强音输入法资源：图标 + 设置对话框
// 本文件是 UTF-8（带 BOM）。rc.exe 默认按系统代码页解析 .rc，
// 在英文 CI（CP1252）上中文会变乱码——code_page(65001) 强制按 UTF-8 读，
// 与系统代码页无关。
#pragma code_page(65001)
#include <windows.h>
#include "src/resids.h"

1 ICON "qiangyin.ico"

// 设置对话框（对话框单位）
IDD_SETTINGS DIALOGEX 0, 0, 222, 204
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "强音输入法设置"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x1
BEGIN
    AUTOCHECKBOX    "候选窗显示编码提示(&H)", IDC_SHOW_HINT, 12, 12, 196, 10
    AUTOCHECKBOX    "组字满 4 码且唯一时自动上屏(&A)", IDC_AUTO_COMMIT, 12, 27, 196, 10
    AUTOCHECKBOX    "中文标点转全角 Ctrl+.", IDC_CHINESE_PUNCT, 12, 42, 196, 10
    AUTOCHECKBOX    "切换到强音时总是中文模式(&C)", IDC_ALWAYS_CHINESE, 12, 57, 196, 10
    AUTOCHECKBOX    "全角模式 Shift+空格", IDC_FULL_SHAPE, 12, 72, 196, 10
    AUTOCHECKBOX    "切换到英文时自动回半角(&W)", IDC_ENG_HALFWIDTH, 12, 87, 196, 10
    AUTOCHECKBOX    "切换到英文时同时用英文标点(&I)", IDC_ENG_ENPUNCT, 12, 102, 196, 10
    AUTOCHECKBOX    "切换中/英时清空组字(&L)（不勾则上屏首选）", IDC_SWITCH_CLEAR, 12, 117, 200, 10
    GROUPBOX        "Enter 键行为", -1, 12, 132, 196, 46
    AUTORADIOBUTTON "清除输入(&E)", IDC_ENTER_CLEARS, 22, 145, 80, 10, WS_GROUP
    AUTORADIOBUTTON "上屏首选(&N)", IDC_ENTER_COMMIT, 110, 145, 80, 10
    AUTORADIOBUTTON "编码上屏(&G)——想要英文字母直接回车", IDC_ENTER_CODE, 22, 160, 180, 10
    LTEXT           "候选数量(&U)：", -1, 12, 186, 58, 8
    COMBOBOX        IDC_CAND_COMBO, 72, 184, 40, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    DEFPUSHBUTTON   "确定", IDOK, 118, 182, 45, 14
    PUSHBUTTON      "取消", IDCANCEL, 168, 182, 45, 14
END

// 在线加词对话框（Ctrl+'+' 呼出，对齐原版超强音形）
IDD_ADDWORD DIALOGEX 0, 0, 244, 92
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "在线加词 - 强音输入法"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x1
BEGIN
    LTEXT           "词条(&W)：", -1, 10, 13, 40, 8
    EDITTEXT        IDC_AW_WORD, 54, 10, 118, 14, ES_AUTOHSCROLL
    LTEXT           "编码(&C)：", -1, 10, 33, 40, 8
    EDITTEXT        IDC_AW_CODE, 54, 30, 118, 14, ES_AUTOHSCROLL
    AUTOCHECKBOX    "使用剪贴板造词(&P)", IDC_AW_CLIP, 54, 52, 120, 10
    LTEXT           "可用 ↑、↓ 更改词长；同码时用户词排在系统词前", -1, 54, 66, 180, 8
    DEFPUSHBUTTON   "确定", IDOK, 186, 10, 45, 14
    PUSHBUTTON      "取消", IDCANCEL, 186, 28, 45, 14
END
